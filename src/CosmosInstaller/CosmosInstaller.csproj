<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CosmosInstaller</AssemblyName>
    <RootNamespace>CosmosInstaller</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Cosmos Studio</Authors>
    <Product>Cosmos .NET Screensaver Installer</Product>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Payload\CosmosScreensaver.scr')">
    <EmbeddedResource Include="Payload\CosmosScreensaver.scr" />
  </ItemGroup>

</Project>
