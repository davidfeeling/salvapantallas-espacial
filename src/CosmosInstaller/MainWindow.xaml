<Window x:Class="CosmosInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de Cosmos .NET — Salvapantallas de Estrellas y Galaxias"
        Width="720"
        Height="630"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <LinearGradientBrush x:Key="CosmicAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0.0" />
            <GradientStop Color="#6366F1" Offset="0.5" />
            <GradientStop Color="#A855F7" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBannerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#060B19" Offset="0.0" />
            <GradientStop Color="#121C3B" Offset="0.55" />
            <GradientStop Color="#1E153A" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="InstallerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17223B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2C3E6B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="border" Property="Background" Value="#213154" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="#090D18"
            BorderBrush="#2C3E6B"
            BorderThickness="1.5"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="155" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- Cabecera Hero con Campo de Estrellas Animado -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeroBannerGradient}"
                    CornerRadius="15,15,0,0"
                    BorderBrush="#24355C"
                    BorderThickness="0,0,0,1"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid>
                    <Canvas x:Name="StarfieldBannerCanvas" IsHitTestVisible="False" />

                    <Button Content="✕"
                            Width="32" Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="16"
                            Style="{StaticResource InstallerButtonStyle}"
                            Padding="0"
                            Click="OnCloseClick" />

                    <StackPanel VerticalAlignment="Center" Margin="28,0,64,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border CornerRadius="6" Background="#2538BDF8" BorderBrush="#38BDF8" BorderThickness="1" Padding="8,2" Margin="0,0,8,0">
                                <TextBlock Text=".NET 9 • WINDOWS SCREENSAVER SUITE" Foreground="#7DD3FC" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="COSMOS .NET // INSTALADOR DEL SISTEMA"
                                   Foreground="#FFFFFF"
                                   FontSize="22"
                                   FontWeight="Bold" />
                        <TextBlock Text="Salvapantallas procedural de estrellas, galaxias espirales, nebulosas y quásares en tiempo real."
                                   Foreground="#94A3B8"
                                   FontSize="12.5"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cuerpo del Instalador -->
            <StackPanel Grid.Row="1" Margin="26,18,26,12">

                <!-- Tarjeta 1: Estado Actual en el Sistema -->
                <Border Background="#11172A"
                        BorderBrush="#233154"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusHeadlineText"
                                           Text="LISTO PARA INSTALAR"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="13.5" />
                            </StackPanel>
                            <TextBlock x:Name="StatusDetailText"
                                       Text="Destino: %LocalAppData%\CosmosScreensaver\CosmosScreensaver.scr"
                                       Foreground="#8E9EC2"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="🖥 Panel Windows (desk.cpl)"
                                Style="{StaticResource InstallerButtonStyle}"
                                Padding="12,7"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Click="OnOpenWindowsControlPanelClick" />
                    </Grid>
                </Border>

                <!-- Tarjeta 2: Opciones de Instalación y Activación -->
                <Border Background="#11172A"
                        BorderBrush="#233154"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PARÁMETROS DE INSTALACIÓN EN WINDOWS"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Tiempo de inactividad para iniciar el salvapantallas"
                                           Foreground="#E2E8F0"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock Text="Se configurará automáticamente en el Registro de Windows."
                                           Foreground="#8E9EC2"
                                           FontSize="11.5" />
                            </StackPanel>

                            <ComboBox x:Name="TimeoutComboBox"
                                      Grid.Column="1"
                                      Height="32"
                                      VerticalContentAlignment="Center"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="1 minuto (60 seg)" Tag="60" />
                                <ComboBoxItem Content="3 minutos (180 seg)" Tag="180" />
                                <ComboBoxItem Content="5 minutos (Recomendado)" Tag="300" />
                                <ComboBoxItem Content="10 minutos (600 seg)" Tag="600" />
                                <ComboBoxItem Content="15 minutos (900 seg)" Tag="900" />
                                <ComboBoxItem Content="30 minutos (1800 seg)" Tag="1800" />
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkStartMenu"
                                  IsChecked="True"
                                  Foreground="#DCE6F7"
                                  FontSize="12.5"
                                  Margin="0,0,0,8"
                                  Content="Crear accesos directos en el Menú Inicio (Configurar e Iniciar Cosmos)" />

                        <CheckBox x:Name="ChkSystem32"
                                  IsChecked="True"
                                  Foreground="#DCE6F7"
                                  FontSize="12.5"
                                  Content="Registrar también en C:\Windows\System32 si cuenta con permisos de Administrador" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Acciones Rápidas de Configuración y Prueba -->
                <Border Background="#11172A"
                        BorderBrush="#233154"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="⚙  Personalizar Densidad y Objetos (/c)"
                                Style="{StaticResource InstallerButtonStyle}"
                                Click="OnConfigureClick" />

                        <Button Grid.Column="2"
                                Content="⛶  Probar Salvapantallas Ahora (/s)"
                                Style="{StaticResource InstallerButtonStyle}"
                                Click="OnTestScreensaverClick" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Barra Inferior Principal -->
            <Border Grid.Row="2"
                    Background="#0D1324"
                    CornerRadius="0,0,15,15"
                    BorderBrush="#1E2B4A"
                    BorderThickness="0,1,0,0"
                    Padding="26,0">
                <DockPanel VerticalAlignment="Center">
                    <Button x:Name="BtnUninstall"
                            DockPanel.Dock="Left"
                            Content="🗑  Desinstalar del Sistema"
                            Style="{StaticResource InstallerButtonStyle}"
                            Click="OnUninstallClick" />

                    <Button x:Name="BtnInstall"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="🚀  Instalar y Activar Salvapantallas"
                            Style="{StaticResource InstallerButtonStyle}"
                            Background="{StaticResource CosmicAccentGradient}"
                            BorderBrush="#7DD3FC"
                            Foreground="White"
                            Padding="24,10"
                            Click="OnInstallClick" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
