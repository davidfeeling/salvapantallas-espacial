<Window x:Class="CosmosScreensaver.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:CosmosScreensaver.Engine"
        Title="Cosmos .NET — Configuración del Salvapantallas"
        Width="1140"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#11172A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#233052" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F5FF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E9EC2" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0.0" />
            <GradientStop Color="#6366F1" Offset="0.55" />
            <GradientStop Color="#8B5CF6" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#19233C" />
            <Setter Property="Foreground" Value="#E6EEFF" />
            <Setter Property="BorderBrush" Value="#2D3F68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="border" Property="Background" Value="#223152" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ObjectToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4ECFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card"
                                Background="#131B30"
                                BorderBrush="#243254"
                                BorderThickness="1.2"
                                CornerRadius="8"
                                Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Indicator"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#26334D"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <Ellipse x:Name="Thumb"
                                             Width="12"
                                             Height="12"
                                             Fill="#8E9EC2"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#162647" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Indicator" Property="Background" Value="#0284C7" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="#090D18"
            BorderBrush="#293A64"
            BorderThickness="1.5"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <!-- Barra Superior Personalizada -->
            <Border Grid.Row="0"
                    Background="#0D1324"
                    CornerRadius="15,15,0,0"
                    BorderBrush="#1E2B4A"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryButtonGradient}" Margin="0,0,12,0">
                            <TextBlock Text="🚀" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COSMOS .NET // INTERSTELLAR FLIGHT ENGINE"
                                       Foreground="#F8FAFC"
                                       FontSize="14.5"
                                       FontWeight="Bold" />
                            <TextBlock Text="Vuelo espacial 3D estilo No Man's Sky con sistemas solares, galaxias, lentes gravitacionales y panel de cabina"
                                       Foreground="#8E9EC2"
                                       FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—"
                                Width="32" Height="28"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="0"
                                Margin="0,0,8,0"
                                Click="OnMinimizeClick" />
                        <Button Content="✕"
                                Width="32" Height="28"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="0"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cuerpo Principal -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="545" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Panel de Ajustes -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <!-- Sección 1: Presets y Paleta de Color -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="1. PERFILES DE VUELO Y PALETA CROMÁTICA"
                                           Foreground="#38BDF8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Modo de Viaje Predefinido" Foreground="#B4C3E4" FontSize="12" Margin="0,0,0,5" />
                                        <ComboBox x:Name="PresetComboBox"
                                                  Height="32"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="OnPresetSelectionChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Paleta Astrofísica / Estilo" Foreground="#B4C3E4" FontSize="12" Margin="0,0,0,5" />
                                        <ComboBox x:Name="PaletteComboBox"
                                                  Height="32"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="OnPaletteSelectionChanged">
                                            <ComboBoxItem Content="Astrofísica Realista (JWST)" />
                                            <ComboBoxItem Content="Cyberpunk / Neón (No Man's Sky)" />
                                            <ComboBoxItem Content="Azul Abisal Criogénico" />
                                            <ComboBoxItem Content="Oro Solar / Horizonte" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sección 2: Tipos de Objetos que Aparecen -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="2. OBJETOS CÓSMICOS QUE APARECEN EN RUTA"
                                           Foreground="#38BDF8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8" />

                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="ChkStars" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="✦ Estrellas con Estela Warp" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Vuelo 3D a gran velocidad" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkSolarSystems" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="☀ Sistemas Solares 3D" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Planetas, anillos y lunas" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkSpiralGalaxies" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="🌀 Galaxias Espirales" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Brazos en perspectiva 3D" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkEllipticalGalaxies" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="🪐 Galaxias Elípticas" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Halos dorados ancestrales" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkBlackHoles" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="🕳 Agujeros Negros" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Curvan la luz y gravedad" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkNebulae" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="☁ Nebulosas Volumétricas" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Nubes de gas interestelar" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkGiantStars" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="✴ Supergigantes JWST" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Destellos de difracción" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkClusters" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="⚛ Cúmulos Globulares" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="Enjambres gravitacionales" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Sección 3: Control de Densidades -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="3. DENSIDAD DEL UNIVERSO"
                                           Foreground="#38BDF8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Densidad de Estrellas en Vuelo" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblStarDensity" Text="2200 estrellas" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderStarDensity" Minimum="100" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Sistemas Solares Completos en Ruta" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblSolarSystemCount" Text="4 sistemas" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderSolarSystemCount" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Galaxias Simultáneas (Espirales / Elípticas)" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblGalaxyCount" Text="5 galaxias" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderGalaxyCount" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Nebulosas Volumétricas" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblNebulaCount" Text="5 nebulosas" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderNebulaCount" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Cúmulos Globulares y Frecuencia de Cometas" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblClusterCount" Text="3 cúmulos" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderClusterCount" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderValueChanged" />
                            </StackPanel>
                        </Border>

                        <!-- Sección 4: Propulsión de la Nave y Panel de Cabina -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="4. VELOCIDAD DE LA NAVE Y PANEL DE CABINA SCI-FI"
                                           Foreground="#38BDF8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Velocidad General de Simulación" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblSimSpeed" Text="1.35x" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderSimSpeed" Minimum="0.2" Maximum="3.0" SmallChange="0.05" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Impulso Hiperespacial (Velocidad Warp 3D)" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblWarpSpeed" Text="1.25" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderWarpSpeed" Minimum="0.1" Maximum="2.5" SmallChange="0.05" ValueChanged="OnSliderValueChanged" Margin="0,0,0,9" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Intensidad de Resplandor Óptico (Bloom / Glow)" Foreground="#E2E8F0" FontSize="12.5" />
                                    <TextBlock x:Name="LblGlow" Text="125%" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderGlow" Minimum="0.4" Maximum="2.2" SmallChange="0.05" ValueChanged="OnSliderValueChanged" Margin="0,0,0,10" />

                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <CheckBox x:Name="ChkHudOverlay" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="🛸 Panel de Cabina Sci-Fi" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Reloj grande + Radar móvil" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkConstellations" Style="{StaticResource ObjectToggleStyle}" Checked="OnControlChanged" Unchecked="OnControlChanged">
                                        <StackPanel>
                                            <TextBlock Text="📐 Red de Constelaciones" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Enlaces geométricos" Foreground="#8E9EC2" FontSize="10.5" />
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Columna Derecha: Visor en Tiempo Real (Live Preview) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="14"
                            BorderBrush="#2C3E6B"
                            BorderThickness="1.5"
                            Background="#020308"
                            ClipToBounds="True">
                        <Grid>
                            <engine:CosmosCanvasControl x:Name="PreviewCanvas" />

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="14"
                                    CornerRadius="8"
                                    Background="#B80B1120"
                                    BorderBrush="#334E85"
                                    BorderThickness="1"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="CABINA EN VIVO // PERSPECTIVA 3D"
                                               Foreground="#E2E8F0"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="14">
                                <Button Content="🔀 Cambiar Esquina HUD"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="OnCycleHudCornerClick" />

                                <Button Content="🎲 Regenerar Ruta"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="OnRegenerateUniverseClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,12,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Protección Anti-Quemado (Salón de Pantallas)" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="El panel holográfico de la nave flota suavemente y se traslada de esquina cada 40s."
                                           Foreground="#8E9EC2"
                                           FontSize="11.5" />
                            </StackPanel>

                            <Button DockPanel.Dock="Right"
                                    Content="⛶  Probar Pantalla Completa"
                                    Style="{StaticResource ModernButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnTestFullScreenClick" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2"
                    Background="#0D1324"
                    CornerRadius="0,0,15,15"
                    BorderBrush="#1E2B4A"
                    BorderThickness="0,1,0,0"
                    Padding="22,0">
                <DockPanel VerticalAlignment="Center">
                    <Button DockPanel.Dock="Left"
                            Content="↺ Restaurar por Defecto"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="OnResetDefaultsClick" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,0,10,0"
                                Click="OnCloseClick" />

                        <Button Content="✔  Guardar Configuración"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource PrimaryButtonGradient}"
                                BorderBrush="#60A5FA"
                                Foreground="White"
                                Padding="20,9"
                                Click="OnSaveAndCloseClick" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
